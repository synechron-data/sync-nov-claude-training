{
    "model": "opusplan",
    "permissions": {
        "allow": [
            "Bash(mvn *)",
            "Bash(npm run *)",
            "Bash(git status)",
            "Bash(git diff)",
            "Bash(git diff *)",
            "Bash(git log *)",
            "Bash(git branch *)",
            "Bash(git checkout -b *)",
            "Bash(git add *)",
            "Bash(git commit *)",
            "Bash(gh auth status)",
            "Read(**)",
            "Write(backend/src/**)",
            "Write(frontend/src/**)"
        ],
        "ask": [
            "Bash(git push:*)",
            "Bash(npm install *)",
            "Write(backend/pom.xml)",
            "Write(frontend/package.json)"
        ],
        "deny": [
            "Read(**/application.properties)",
            "Read(**/*.key)",
            "Bash(rm -rf:*)",
            "Bash(curl:*)",
            "Bash(wget:*)"
        ]
    }
}