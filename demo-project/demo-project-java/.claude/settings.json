{
    "model": "opusplan",
    "permissions": {
        "allow": [
            "Bash(mvn *)",
            "Bash(npm run *)",
            "Bash(git status)",
            "Bash(git diff)",
            "Bash(git diff *)",
            "Bash(git log *)",
            "Bash(git branch *)",
            "Bash(git checkout -b *)",
            "Bash(git add *)",
            "Bash(git commit *)",
            "Bash(gh auth status)",
            "Read(**)",
            "Write(backend/src/**)",
            "Write(frontend/src/**)",
            "Write(.claude/agent-memory/**)",
            "Edit(.claude/agent-memory/**)"
        ],
        "ask": [
            "Bash(git push:*)",
            "Bash(npm install *)",
            "Edit(backend/pom.xml)",
            "Edit(frontend/package.json)"
        ],
        "deny": [
            "Read(**/application.properties)",
            "Read(**/*.key)",
            "Bash(rm -rf:*)",
            "Bash(curl:*)",
            "Bash(wget:*)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash|Powershell",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse-demo.js\""
                    },
                    {
                        "type": "command",
                        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/bash-guard.js\""
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-fix.js\""
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-log.js\""
                    }
                ]
            }
        ]
    }
}